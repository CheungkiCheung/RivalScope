generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  URL
  MARKDOWN
  PDF
  TEXT
}

enum WorkflowNodeStatus {
  PENDING
  READY
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  BLOCKED
}

enum WorkflowNodeType {
  AGENT
  TOOL
  MANUAL_REVIEW
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ToolCallStatus {
  SUCCEEDED
  FAILED
}

enum ClaimKind {
  SINGLE_COMPETITOR
  COMPARATIVE
  RECOMMENDATION
}

enum EvidenceSpanType {
  SUPPORTING
  COUNTER
  CONTEXT
}

enum AtomicFactPolarity {
  SUPPORTS
  CONTRADICTS
  CONTEXT
}

enum ClaimType {
  CAPABILITY
  PRICING
  POSITIONING
  RISK
  RECOMMENDATION
}

enum ClaimStatus {
  DRAFT
  NEEDS_EVIDENCE
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum ClaimVerdict {
  SUPPORTED
  NEEDS_MORE_EVIDENCE
  REFUTED
  HYPOTHESIS
}

enum ReportStatus {
  DRAFT
  REVIEWED
  FINAL
}

enum ReportBlockStatus {
  DRAFT
  READY
  BLOCKED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingCategory {
  UNSUPPORTED_CLAIM
  UNKNOWN_FACT
  UNKNOWN_EVIDENCE_SPAN
  LOW_CONFIDENCE
  UNCITED_REPORT_SECTION
  UNKNOWN_CLAIM
  MISSING_DIMENSION
  TRACE_GAP
  COUNTER_EVIDENCE
  ROLE_VIOLATION
}

enum FindingTargetType {
  CLAIM
  EVIDENCE_SPAN
  REPORT_BLOCK
  AGENT_RUN
}

enum TraceValidationStatus {
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum TraceEdgeKind {
  SOURCE_SNAPSHOT_TO_EVIDENCE_SPAN
  EVIDENCE_SPAN_TO_ATOMIC_FACT
  ATOMIC_FACT_TO_CLAIM
  CLAIM_TO_REPORT_BLOCK
  TRACE_VALIDATED_BY
  SUPPORTS
  REFUTES
  QUALIFIES
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  competitors        Competitor[]
  analysisDimensions AnalysisDimension[]
  sources            Source[]
  sourceSnapshots    SourceSnapshot[]
  evidenceSpans      EvidenceSpan[]
  atomicFacts        AtomicFact[]
  knowledgeItems     KnowledgeItem[]
  facts              Fact[]
  claims             Claim[]
  workflows          Workflow[]
  reports            Report[]
  reportBlocks       ReportBlock[]
  artifacts          Artifact[]
  reviewFindings     ReviewFinding[]
  traceEdges         TraceEdge[]
  traceValidations   TraceValidationResult[]
  modelRuns          ModelRun[]
  humanFeedback      HumanFeedback[]

  @@index([ownerId])
}

model Competitor {
  id        String   @id @default(cuid())
  projectId String
  name      String
  website   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  facts   Fact[]
  atomicFacts AtomicFact[]
  knowledgeItems KnowledgeItem[]

  @@index([projectId])
}

model AnalysisDimension {
  id          String   @id @default(cuid())
  projectId   String
  key         String
  label       String
  description String?
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

model Source {
  id          String     @id @default(cuid())
  projectId   String
  kind        SourceKind
  title       String
  uri         String
  collectedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  SourceChunk[]

  @@index([projectId])
}

model SourceSnapshot {
  id           String     @id @default(cuid())
  projectId    String
  sourceId     String
  sourceKind   SourceKind
  title        String
  canonicalUrl String
  retrievedAt  DateTime
  contentHash  String
  rawText      String
  metadata     Json
  createdAt    DateTime   @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceSpans EvidenceSpan[]

  @@index([projectId])
  @@index([sourceId])
  @@unique([projectId, contentHash])
}

model EvidenceSpan {
  id           String           @id @default(cuid())
  projectId    String
  snapshotId   String
  sourceId     String
  text         String
  startOffset  Int
  endOffset    Int
  quoteHash    String
  spanType     EvidenceSpanType
  qualityScore Float
  capturedAt   DateTime
  createdAt    DateTime         @default(now())

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot     SourceSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  atomicFacts  AtomicFactEvidenceSpan[]
  claims       ClaimEvidenceSpan[]
  reportBlocks ReportBlockEvidenceSpan[]

  @@index([projectId])
  @@index([snapshotId])
  @@index([sourceId])
}

model AtomicFact {
  id           String             @id @default(cuid())
  projectId    String
  competitorId String
  dimension    String
  statement    String
  confidence   Float
  polarity     AtomicFactPolarity
  extractedAt  DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor    Competitor               @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  evidenceSpans AtomicFactEvidenceSpan[]
  knowledgeItems KnowledgeItemAtomicFact[]
  claims        ClaimAtomicFact[]

  @@index([projectId])
  @@index([competitorId])
  @@index([dimension])
}

model AtomicFactEvidenceSpan {
  atomicFactId   String
  evidenceSpanId String

  atomicFact   AtomicFact   @relation(fields: [atomicFactId], references: [id], onDelete: Cascade)
  evidenceSpan EvidenceSpan @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)

  @@id([atomicFactId, evidenceSpanId])
  @@index([evidenceSpanId])
}

model KnowledgeItem {
  id           String   @id @default(cuid())
  projectId    String
  competitorId String
  dimension    String
  label        String
  summary      String
  confidence   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor  Competitor                @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  atomicFacts KnowledgeItemAtomicFact[]

  @@index([projectId])
  @@index([competitorId])
  @@index([dimension])
}

model KnowledgeItemAtomicFact {
  knowledgeItemId String
  atomicFactId    String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  atomicFact    AtomicFact    @relation(fields: [atomicFactId], references: [id], onDelete: Cascade)

  @@id([knowledgeItemId, atomicFactId])
  @@index([atomicFactId])
}

model SourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  ordinal    Int
  text       String
  tokenCount Int
  createdAt  DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  facts  FactSourceChunk[]

  @@unique([sourceId, ordinal])
  @@index([sourceId])
}

model Fact {
  id           String   @id @default(cuid())
  projectId    String
  competitorId String
  dimension    String
  statement    String
  confidence   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitor Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  chunks     FactSourceChunk[]
  claims     ClaimFact[]

  @@index([projectId])
  @@index([competitorId])
  @@index([dimension])
}

model FactSourceChunk {
  factId  String
  chunkId String

  fact  Fact        @relation(fields: [factId], references: [id], onDelete: Cascade)
  chunk SourceChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([factId, chunkId])
  @@index([chunkId])
}

model Claim {
  id                   String       @id @default(cuid())
  projectId            String
  dimension            String
  statement            String
  confidence           Float
  confidenceBreakdown  Json?
  sourceQuality        Float?
  freshness            Float?
  counterEvidenceCount Int          @default(0)
  kind                 ClaimKind
  type                 ClaimType?
  status               ClaimStatus  @default(DRAFT)
  verdict              ClaimVerdict @default(HYPOTHESIS)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  facts          ClaimFact[]
  atomicFacts    ClaimAtomicFact[]
  evidenceSpans  ClaimEvidenceSpan[]
  reportSections ReportSectionClaim[]
  reportBlocks   ReportBlockClaim[]
  feedback       HumanFeedback[]

  @@index([projectId])
  @@index([dimension])
  @@index([status])
  @@index([verdict])
}

model ClaimFact {
  claimId String
  factId  String

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fact  Fact  @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@id([claimId, factId])
  @@index([factId])
}

model ClaimAtomicFact {
  claimId      String
  atomicFactId String

  claim      Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  atomicFact AtomicFact @relation(fields: [atomicFactId], references: [id], onDelete: Cascade)

  @@id([claimId, atomicFactId])
  @@index([atomicFactId])
}

model ClaimEvidenceSpan {
  claimId        String
  evidenceSpanId String

  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceSpan EvidenceSpan @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)

  @@id([claimId, evidenceSpanId])
  @@index([evidenceSpanId])
}

model Workflow {
  id        String   @id @default(cuid())
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   WorkflowNode[]

  @@index([projectId])
}

model WorkflowNode {
  id                String             @id @default(cuid())
  workflowId        String
  nodeKey           String
  type              WorkflowNodeType
  agentName         String
  dependsOn         String[]
  status            WorkflowNodeStatus @default(PENDING)
  inputArtifactIds  String[]
  outputArtifactIds String[]
  retryCount        Int                @default(0)
  maxRetries        Int                @default(1)
  currentAgentRunId String?
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?

  workflow  Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]

  @@unique([workflowId, nodeKey])
  @@index([workflowId])
  @@index([status])
}

model AgentRun {
  id             String         @id @default(cuid())
  workflowNodeId String
  agentName      String
  status         AgentRunStatus
  input          Json
  output         Json?
  errorMessage   String?
  startedAt      DateTime
  finishedAt     DateTime?

  workflowNode WorkflowNode @relation(fields: [workflowNodeId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]

  @@index([workflowNodeId])
  @@index([agentName])
  @@index([status])
}

model ToolCall {
  id           String         @id @default(cuid())
  agentRunId   String
  toolName     String
  status       ToolCallStatus
  input        Json
  output       Json?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([toolName])
  @@index([status])
}

model Artifact {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  value     Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([kind])
}

model Report {
  id           String       @id @default(cuid())
  projectId    String
  title        String
  status       ReportStatus @default(DRAFT)
  qualityScore Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections       ReportSection[]
  blocks         ReportBlock[]
  reviewFindings ReviewFinding[]

  @@index([projectId])
  @@index([status])
}

model ReportSection {
  id        String @id @default(cuid())
  reportId  String
  sectionKey String
  title     String
  body      String
  ordinal   Int

  report Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  claims ReportSectionClaim[]

  @@unique([reportId, sectionKey])
  @@index([reportId])
}

model ReportSectionClaim {
  reportSectionId String
  claimId         String

  reportSection ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  claim         Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([reportSectionId, claimId])
  @@index([claimId])
}

model ReportBlock {
  id        String            @id @default(cuid())
  projectId String
  reportId  String?
  blockKey  String
  title     String
  body      String
  ordinal   Int
  status    ReportBlockStatus @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report        Report?                   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  claims        ReportBlockClaim[]
  evidenceSpans ReportBlockEvidenceSpan[]

  @@unique([projectId, blockKey])
  @@index([projectId])
  @@index([reportId])
}

model ReportBlockClaim {
  reportBlockId String
  claimId       String

  reportBlock ReportBlock @relation(fields: [reportBlockId], references: [id], onDelete: Cascade)
  claim       Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([reportBlockId, claimId])
  @@index([claimId])
}

model ReportBlockEvidenceSpan {
  reportBlockId  String
  evidenceSpanId String

  reportBlock  ReportBlock  @relation(fields: [reportBlockId], references: [id], onDelete: Cascade)
  evidenceSpan EvidenceSpan @relation(fields: [evidenceSpanId], references: [id], onDelete: Cascade)

  @@id([reportBlockId, evidenceSpanId])
  @@index([evidenceSpanId])
}

model ReviewFinding {
  id        String          @id @default(cuid())
  projectId String
  reportId  String?
  severity  FindingSeverity
  category  FindingCategory
  message   String
  targetType FindingTargetType?
  targetId   String?
  agentName  String?
  createdAt DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report  Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([reportId])
  @@index([severity])
  @@index([category])
  @@index([targetType, targetId])
}

model TraceEdge {
  id         String        @id @default(cuid())
  projectId  String
  fromType   String
  fromId     String
  toType     String
  toId       String
  kind       TraceEdgeKind
  metadata   Json?
  createdAt  DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([kind])
}

model TraceValidationResult {
  id                     String                @id @default(cuid())
  projectId              String
  status                 TraceValidationStatus
  checkedClaimIds        String[]
  checkedEvidenceSpanIds String[]
  reportBlockIds         String[]
  findings               Json
  validatedAt            DateTime
  createdAt              DateTime              @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ModelRun {
  id          String         @id @default(cuid())
  projectId   String
  agentRunId  String?
  provider    String
  model       String
  promptHash  String
  input       Json
  output      Json?
  status      AgentRunStatus
  tokenUsage  Json?
  costUsd     Float?
  startedAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([agentRunId])
  @@index([status])
}

model HumanFeedback {
  id        String   @id @default(cuid())
  projectId String
  claimId   String?
  rating    String
  comment   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  claim   Claim?  @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([claimId])
}
