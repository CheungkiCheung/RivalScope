DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rivalscope?schema=public"

# Source collection uses deterministic fixture search by default.
# Set these to collect source URLs through Tavily instead.
RIVALSCOPE_SEARCH_PROVIDER="fixture"
TAVILY_API_KEY=""

# Analysis agents use deterministic mock logic by default.
# Set these to let Extract and Analyst call an OpenAI-compatible chat completion endpoint.
RIVALSCOPE_ANALYSIS_AGENT_MODE="mock"
RIVALSCOPE_MODEL_PROVIDER="mock"
RIVALSCOPE_ENABLE_MODEL_ENTAILMENT_JUDGE="false"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gpt-4o-mini"
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"

# Mimo is also supported as a model provider.
# It uses OpenAI-compatible chat completions with api-key authentication.
MIMO_API_KEY=""
MIMO_MODEL="mimo-v2-pro"
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
